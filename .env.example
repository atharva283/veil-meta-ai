# Copy to .env and fill in on Oct 26. Every blank integration runs on its offline mock.

# --- Meta Model API: Llama 3.1 planner (and, by default, Muse Spark auditor) ---
META_MODEL_API_KEY=
# OpenAI-compatible chat completions base URL. Confirm the exact URL in the hackathon docs.
META_MODEL_API_BASE=https://api.llama.com/compat/v1
# Confirm the exact model id from the provider's model list.
PLANNER_MODEL=Llama-3.1-70B-Instruct
# Alternative: Llama 3.1 on Fireworks ($25 credits). If you do this, also set the
# AUDITOR_* values below so Muse Spark still goes to Meta.
#   META_MODEL_API_BASE=https://api.fireworks.ai/inference/v1
#   PLANNER_MODEL=accounts/fireworks/models/llama-v3p1-70b-instruct

# --- Muse Spark auditor (defaults to the key and base URL above) ---
AUDITOR_MODEL=muse-spark
AUDITOR_API_BASE=
AUDITOR_API_KEY=

# --- SAM 3.1 on Modal (deploy backend/modal_app/sam3_service.py) ---
MODAL_ENDPOINT=
# Must match VEIL_TOKEN in the "veil-sam3" Modal secret.
MODAL_AUTH_TOKEN=

# --- Switches and tuning ---
# Keep components on mocks even when keys are set, e.g. "auditor" or "planner,segmenter".
VEIL_FORCE_MOCK=
AUDIT_SAMPLE_FPS=2
AUDIT_MAX_ROUNDS=2
MAX_UPLOAD_MB=200
REQUEST_TIMEOUT_S=120
